# DOO Root .gitignore

# Environment variables and secrets
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
*.pem

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Build outputs
target/
*/target/
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
*.class
*.jar
*.war
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE and Editor files
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
