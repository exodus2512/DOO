# ==============================================================================
# DOO Browser Worker — Environment Configuration
# ==============================================================================

# Server configuration
BROWSER_WORKER_PORT=3001
BROWSER_WORKER_SECRET=doo-secure-worker-secret-key-phase1

# ------------------------------------------------------------------------------
# Browser Execution & Display Mode
# ------------------------------------------------------------------------------
# Set HEADED=true (or HEADLESS=false) to launch visible browser windows on your screen.
# Default: headless (HEADED=false / HEADLESS=true)
HEADED=false
HEADLESS=true

# IMPORTANT NOTICE REGARDING HEADED MODE:
# 1. Headed mode uses `channel: 'chrome'` and requires Google Chrome to be installed
#    locally on the host machine.
# 2. docker-compose forces HEADLESS=true and runs inside a container without a display
#    server. docker-compose is NOT intended for interactive desktop handoff.
# 3. For interactive human-in-the-loop handoff with visible desktop windows, run the
#    worker directly on the host using `npm start` or `./start-dev.ps1`.

# ------------------------------------------------------------------------------
# Profile Mode
# ------------------------------------------------------------------------------
# PROFILE_MODE controls browser profile persistence:
# - 'persistent' (default): Launches persistent browser contexts with per-domain
#   user data directories (retains real cookies, local storage, and sessions).
# - 'storage': Launches ephemeral contexts and saves session state snapshots to JSON.
PROFILE_MODE=persistent

# Path where browser session storage state and profiles are kept
STORAGE_STATE_DIR=./storage_state

# ------------------------------------------------------------------------------
# Polite Client & Regional Settings
# ------------------------------------------------------------------------------
# Emulated locale and timezone matching the user's geographic region
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata

# Default viewport dimensions
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800

# ------------------------------------------------------------------------------
# Session Lifecycle & Idle Timeouts (in milliseconds)
# ------------------------------------------------------------------------------
# Absolute session TTL (default: 60 minutes)
SESSION_TTL_MS=3600000

# Idle session timeout for active tasks (default: 15 minutes)
SESSION_IDLE_MS=900000

# Extended idle timeout for parked sessions waiting for user approval/handoff (default: 35 minutes)
PARKED_IDLE_MS=2100000
