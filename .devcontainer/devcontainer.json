{
  "name": "DOO Development",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    },
    "ghcr.io/devcontainers/features/maven:1": {}
  },
  "postCreateCommand": "cd browser-worker && npm ci && npx playwright install --with-deps chromium && cd ../frontend && npm ci",
  "forwardPorts": [3000, 8081, 8082],
  "portsAttributes": {
    "3000": { "label": "Frontend", "onAutoForward": "notify" },
    "8081": { "label": "Test Fixture", "onAutoForward": "silent" },
    "8082": { "label": "Backend API", "onAutoForward": "notify" },
    "3001": { "label": "Browser Worker (internal)", "onAutoForward": "ignore" }
  },
  "containerEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current",
    "DEMO_MODE": "true",
    "HEADLESS": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/local/sdkman/candidates/java/current",
            "default": true
          }
        ]
      }
    }
  }
}
