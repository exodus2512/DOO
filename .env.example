# ==============================================================================
# DOO — Autonomous Browser Agent Configuration (.env)
# ==============================================================================

# --- Database (Neon Cloud PostgreSQL or local PostgreSQL) ---
# Replace with your Neon connection URL:
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-misty-fire-a1b2c3d4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# --- AI Provider ---
# Options: gemini (default), demo (deterministic mock for offline testing)
DOO_AI_PROVIDER=gemini
# Keys in the same Google Cloud project share quota — spread across projects for best results
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Browser Worker Service ---
BROWSER_WORKER_URL=http://localhost:3001
BROWSER_WORKER_SECRET=doo-secure-worker-secret-key-phase1

# --- Security & Execution Limits ---
DOO_MAX_STEPS=15
DOO_MAX_CONSECUTIVE_FAILURES=3
DOO_STEP_TIMEOUT_SECONDS=30
DOO_ALLOWED_ACTIONS=NAVIGATE,CLICK,FILL,SCREENSHOT,EXTRACT_TEXT,SCROLL,WAIT,GO_BACK,DONE

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8080
